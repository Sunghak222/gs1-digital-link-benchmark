<!DOCTYPE html>
<html lang="{{ lang }}">
<head><meta charset="{{ charset }}"><title>{{ title }}</title></head>
<body>
<nav class="global-nav"><ul><li><a href="#">{{ labels.nav_home }}</a></li><li><a href="#">{{ labels.nav_services }}</a></li><li><a href="#">{{ labels.nav_events }}</a></li><li><a href="#">{{ labels.nav_contact }}</a></li></ul></nav>
<div class="hero-banner"><span>{{ labels.banner }}</span></div>
<div class="layout">
<aside class="sidebar">
  <div class="widget promo"><h3>{{ labels.promo_title }}</h3><p>{{ labels.promo_body }}</p></div>
  <div class="widget links"><h3>{{ labels.quick_links }}</h3><ul><li><a href="#">FAQ</a></li><li><a href="#">SNS</a></li></ul></div>
</aside>
<main>
<h1>{{ title }}</h1>
{% for p in passages %}<p>{{ p }}</p>
{% endfor %}
{% if scalars %}<h2>{{ labels.details }}</h2>
<dl>
{% for label, value in scalars %}  <dt>{{ label }}</dt><dd>{{ value }}</dd>
{% endfor %}</dl>
{% endif %}
{% for label, items in lists %}<h2>{{ label }}</h2>
<ul>
{% for item in items %}  <li>{{ item }}</li>
{% endfor %}</ul>
{% endfor %}
{% if nutrition %}<h2>{{ labels.nutrition }}</h2>
{% if nutrition.serving_size %}<p>{{ labels.serving }}: {{ nutrition.serving_size }}</p>{% endif %}
<table>
<tr><th>{{ labels.nutrient }}</th><th>{{ labels.per100 }}</th><th>{{ labels.per_serving }}</th></tr>
{% for name, per100, serving in nutrition.rows %}<tr><td>{{ name }}</td><td>{{ per100 }}</td><td>{{ serving }}</td></tr>
{% endfor %}</table>
{% endif %}
{% for heading, text in boilerplate %}<h2>{{ heading }}</h2>
<p>{{ text }}</p>
{% endfor %}
</main>
</div>
<footer><p>{{ labels.footer }}</p><ul><li><a href="#">{{ labels.nav_privacy }}</a></li><li><a href="#">{{ labels.nav_terms }}</a></li></ul></footer>
</body>
</html>
